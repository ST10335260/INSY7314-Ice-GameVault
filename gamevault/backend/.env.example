# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database ----
# Local MongoDB, Docker (docker run -d -p 27017:27017 mongo:7) or a MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/gamevault

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
# Leave blank to auto-decide (secure in production / when HTTPS is on)
COOKIE_SECURE=

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---- HTTPS (optional, run `npm run certs` first) ----
USE_HTTPS=false
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# ---- Seed accounts (used by `npm run seed`) ----
ADMIN_EMAIL=admin@gamevault.local
ADMIN_PASSWORD=Admin@12345
