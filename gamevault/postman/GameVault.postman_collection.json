      "name": "1. Auth",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now();",
                  "pm.collectionVariables.set('username', 'player_' + id);",
                  "pm.collectionVariables.set('email', 'player' + id + '@test.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role cannot be self-assigned', () => pm.expect(pm.response.json().user.role).to.eql('user'));",
                  "pm.test('Password is never returned', () => pm.expect(pm.response.json().user.password).to.be.undefined);",
                  "pm.test('Security headers present', () => { pm.response.to.have.header('Content-Security-Policy'); pm.response.to.have.header('X-Content-Type-Options', 'nosniff'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}",
